```mermaid
classDiagram
    class User {
        +Integer id
        +String tokenUser
        +String publicKey
        +String socketId
        +String recovery_accout_text
        +Date createdAt
        +Date updatedAt
    }

    class Friend {
        +Integer id
        +Integer user_id
        +Integer friend_id
        +Date createdAt
        +Date updatedAt
    }

    class Conversation {
        +Integer id
        +Integer user_one
        +Integer user_two
        +Date createdAt
        +Date updatedAt
    }

    %% Associations User & Friend
    User "1" -- "*" Friend : hasMany (friendships)
    User "1" -- "*" Friend : hasMany (friendOf)

    %% Associations User & Conversation
    User "1" -- "*" Conversation : hasMany (conversationsAsUserOne)
    User "1" -- "*" Conversation : hasMany (conversationsAsUserTwo)
    
```
